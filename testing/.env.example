# Environment for run_trials.py. Loaded via python-dotenv (load_dotenv())
# from testing/.env — copy this file to testing/.env and fill in real values.
# The real .env is gitignored (see repo-root .gitignore's ".env" / ".env.*"
# rules) — never commit it.
#
# RAG embeddings go through RAG_5-9_ollama/database_engine.py (a local
# Ollama server), not a cloud API key — see RAG_5-9_ollama/README.md for
# the `ollama serve` / `ollama pull nomic-embed-text` setup it needs.

ANTHROPIC_API_KEY=
