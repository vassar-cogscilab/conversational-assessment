# Backend (convo-api) environment variables.
# Loaded by app.py via python-dotenv (load_dotenv()). The placeholder server
# only reads PORT. As the backend grows, add secrets here (DB URLs, API keys,
# etc.), document them, and read them with os.environ in app.py.
# The real .env is gitignored — never commit it.

PORT=3001

# Which LLM backend the examiner runs on: "anthropic" (default) or "ollama".
# See backend/llm.py. Anthropic is the default deliberately — the Ollama path
# depends on the tailnet and on lambda-server being up, and leaving the
# fallback one env var away makes an outage a config change, not a rollback.
LLM_BACKEND=anthropic

# Written automatically on the server by the deploy workflow from the
# LLM_API_KEY GitHub secret. For local dev, set your own key here.
# Only required when LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 (see llm.py).
ANTHROPIC_MODEL=

# --- LLM_BACKEND=ollama only -------------------------------------------------
# Self-hosted Ollama on the lab's GPU box (lambda-server), reached over
# Tailscale. Both nodes were brought up with --accept-dns=false, so MagicDNS
# names do not resolve — the EC2 box has an /etc/hosts entry mapping
# lambda-server to its tailnet IP. Plain http:// is correct: `tailscale serve
# --tcp` is a raw TCP forwarder, so https:// to this port fails.
OLLAMA_HOST=http://lambda-server:11434
# gemma4:26b (MoE, ~67 tok/s) is the default. llama3.3:70b is stronger but
# needs OLLAMA_NUM_CTX=32768 — at the server's default 128K context it
# overflows VRAM, spills to CPU, and drops to ~2.4 tok/s.
OLLAMA_MODEL=gemma4:26b
OLLAMA_NUM_CTX=
# Seconds to allow for a single generation. The default (300) is generous
# because a cold start has to page a ~17 GB model back onto the GPUs.
OLLAMA_TIMEOUT=
# How long Ollama keeps the model resident; -1 means never unload. Left at -1
# so the first student after an idle stretch doesn't pay the cold start.
OLLAMA_KEEP_ALIVE=-1
# -----------------------------------------------------------------------------

# Shared secret for the /admin/sessions endpoints (send as the X-Admin-Token
# header, or ?token= for quick browser use). Written by the deploy workflow
# from the ADMIN_TOKEN GitHub secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# RAG embeddings (RAG_5-9/database_engine.py). Cloud API, no local model or
# tunnel needed. Free for this project's volume (first 200M tokens/account
# are free on voyage-4-large). Get a key at https://dash.voyageai.com/
VOYAGE_API_KEY=
