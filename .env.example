# Backend (convo-api) environment variables.
# Loaded by app.py via python-dotenv (load_dotenv()). The placeholder server
# only reads PORT. As the backend grows, add secrets here (DB URLs, API keys,
# etc.), document them, and read them with os.environ in app.py.
# The real .env is gitignored — never commit it.

PORT=3001

# Written automatically on the server by the deploy workflow from the
# LLM_API_KEY GitHub secret. For local dev, set your own key here.
ANTHROPIC_API_KEY=
# Shared secret for the /admin/sessions endpoints (send as the X-Admin-Token
# header, or ?token= for quick browser use). Not wired through the deploy
# workflow — set it by hand in the server's .env. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# RAG embeddings (RAG_5-9/database_engine.py). Cloud API, no local model or
# tunnel needed. Free for this project's volume (first 200M tokens/account
# are free on voyage-4-large). Get a key at https://dash.voyageai.com/
VOYAGE_API_KEY=
